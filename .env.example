# Penpod AI API (OpenAI-compatible)
# Dapatkan API Key di https://ai.penpod.id (dimulai dengan gp-...)
PENPOD_API_KEY=gp-your_penpod_api_key_here
PENPOD_BASE_URL=https://ai.penpod.id/v1
# Model rekomendasi: gemini-3.8-flash-high (Cepat, Audio+Video+Reasoning, Murah $0.75 in / $3.75 out)
# Alternatif: gemini-4-argon-high, claude-opus-4-6-thinking, deepseek-v4.1-flash:paid, gpt-6-luna
PENPOD_MODEL=gemini-3.8-flash-high

# Google Gemini API Key (Opsional / Fallback)
# Dapatkan API Key gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Voicebox Service Configuration (Single Runtime / Sidecar)
VOICEBOX_HOST=127.0.0.1
VOICEBOX_PORT=17493
VOICEBOX_VOICE=default

